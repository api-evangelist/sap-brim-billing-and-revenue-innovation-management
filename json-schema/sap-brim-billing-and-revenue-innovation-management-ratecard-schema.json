{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/RateCard",
  "title": "RateCard",
  "type": "object",
  "properties": {
    "rateCardId": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "unit": {
      "type": "string",
      "description": "Unit of measurement"
    },
    "baseRate": {
      "type": "number",
      "format": "double"
    },
    "tiers": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/PricingTier"
      }
    },
    "effectiveFrom": {
      "type": "string",
      "format": "date"
    },
    "effectiveTo": {
      "type": "string",
      "format": "date"
    }
  }
}